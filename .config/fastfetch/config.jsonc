// fastfetch: dashboard layout (wallpaper in five slices, info, usage meters, palette)
// Every color is a terminal palette slot, so it follows the wallpaper.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.cache/wal/fastfetch-logo.png",
        "type": "kitty-direct",
        "width": 34,
        "height": 9,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "",
        "color": {
            "keys": "blue",
            "title": "red"
        }
    },
    "modules": [
        "break",
        {
            "type": "title"
        },
        {
            "type": "uptime",
            "key": "󰥔 Uptime   ",
            "keyColor": "bright_black"
        },
        "break",
        {
            "type": "os",
            "key": " OS       ",
            "format": "{pretty-name}"
        },
        {
            "type": "wm",
            "key": " Desktop  ",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "terminal",
            "key": " Terminal "
        },
        {
            "type": "shell",
            "key": " Shell    "
        },
        {
            "type": "cpu",
            "key": " CPU      ",
            "format": "{name}"
        },
        "break",
        {
            "type": "command",
            "key": "󰻠 CPU use  ",
            "keyColor": "red",
            "text": "bash ~/.config/fastfetch/meters.sh cpu 1"
        },
        {
            "type": "command",
            "key": "󰍛 Memory   ",
            "keyColor": "magenta",
            "text": "bash ~/.config/fastfetch/meters.sh memory 5"
        },
        {
            "type": "command",
            "key": "󰋊 Disk /   ",
            "keyColor": "cyan",
            "text": "bash ~/.config/fastfetch/meters.sh disk 6"
        },
        {
            "type": "command",
            "key": "󰁹 Battery  ",
            "keyColor": "yellow",
            "text": "bash ~/.config/fastfetch/meters.sh battery 3"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}
