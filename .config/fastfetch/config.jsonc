{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "kitty-direct",
        "width": 28,
        "height": 14,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": " : {user-name} @ {host-name}"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "kernel",
            "key": "󰌢 Kernel"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "display",
            "key": "󰍹 Display"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "custom",
            "format": "│"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰘚 Memory"
        },
        {
            "type": "uptime",
            "key": "󰔛 Uptime"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
