{
    "label" : "logout",
    "action" : "loginctl terminate-session $XDG_SESSION_ID || hyprctl dispatch exit",
    "text" : "",
    "keybind" : "e",
    "circular" : true
}

{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "",
    "keybind" : "s",
    "circular" : true
}

{
    "label" : "hibernate",
    "action" : "bash ~/.config/wlogout/hibernate.sh",
    "text" : "",
    "keybind" : "h",
    "circular" : true
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "",
    "keybind" : "r",
    "circular" : true
}
