// Line: a thin strip flush with the screen edge, window title in the middle.
{
    "x-floating": false,
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "group/system", "custom/notification", "clock"],

    "clock": { "format": "{:%H:%M}" },

    "x-vertical": {
        // No room for a window title on a side bar
        "modules-center": []
    }
}
