{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-center": ["hyprland/workspaces", "wlr/taskbar"],


    "hyprland/workspaces": {
        "format": "{name}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5 ]
        }
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    }
} 

