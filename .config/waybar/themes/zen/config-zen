// Zen: one centered island (time, workspace dots, battery); the rest slides out of a drawer on hover.
{
    "modules-left": [],
    "modules-center": ["clock", "hyprland/workspaces", "battery", "group/zen"],
    "modules-right": [],

    "clock": { "format": "{:%H:%M}" },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "" }
    },

    "group/zen": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": true,
            "children-class": "zen-child"
        },
        "modules": ["custom/zen-handle", "pulseaudio", "backlight", "bluetooth", "network", "custom/notification"]
    },

    "custom/zen-handle": {
        "format": "",
        "tooltip-format": "Hover for volume, brightness, Bluetooth, Wi-Fi and notifications"
    },

    "x-vertical": {
        "custom/zen-handle": { "format": "" }
    }
}
