// Experimental: colored workspace bars, now-playing chip, CPU/RAM level glyphs, icon-only status.
{
    "modules-left": ["custom/launcher", "clock"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["mpris", "group/load", "tray", "group/system"],

    "clock": { "format": "{:%H:%M}" },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": "" }
    },

    "group/system": {
        "modules": ["custom/notification", "pulseaudio", "backlight", "bluetooth", "network", "battery"]
    },

    // Icons only; exact values are in the tooltips
    "pulseaudio": { "format": "{icon}", "format-muted": "󰝟" },
    "backlight": { "format": "{icon}" }
}
