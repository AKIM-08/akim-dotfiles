// Default: three floating islands.
// Shared module definitions live in ../modules.json; scripts/layout.py merges them with this
// file and sets the position, margins and compact side-bar formats.
{
    "modules-left": ["custom/launcher", "clock", "tray"],
    "modules-center": ["hyprland/workspaces", "wlr/taskbar"],
    "modules-right": ["custom/media", "custom/notification", "group/system"],

    "tray": { "icon-size": 15, "spacing": 8 },

    "x-vertical": {
        // Side bars: slightly smaller app icons so 14 workspaces + apps still fit
        "wlr/taskbar": { "icon-size": 14 }
    }
}
