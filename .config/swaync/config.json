{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "control-center-positionX": "left",
    "control-center-positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",
    "ignore-gtk-theme": true,
    "control-center-width": 380,
    "control-center-height": 1008,
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 12,
    "control-center-margin-right": 0,
    "control-center-margin-left": 12,
    "notification-2fa-action": true,
    "notification-inline-replies": true,
    "notification-grouping": false,
    "notification-window-width": 380,
    "notification-icon-size": 60,
    "notification-body-image-height": 180,
    "notification-body-image-width": 180,
    "timeout": 12,
    "timeout-low": 6,
    "timeout-critical": 1,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "widgets": [
        "mpris",
        "buttons-grid",
        "volume",
        "backlight",
        "title",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "label": {
            "max-lines": 1,
            "text": "Notification Center!"
        },
        "mpris": {
            "image-size": 80,
            "image-radius": 12
        },
        "volume": {
            "label": "󰕾 ",
            "show-value": true,
            "show-per-app": true,
            "show-per-app-icon": true,
            "show-per-app-label": true,
            "expand-button-label": "▾",
            "collapse-button-label": "▴",
            "empty-list-label": "No app is playing sound"
        },
        "backlight": {
            "label": "󰃟 ",
            "device": "intel_backlight",
            "subsystem": "backlight"
        },
        "buttons-grid": {
            "buttons-per-row": 2,
            "actions": [
                {
                    "label": "󰝟   Mute",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh $HOME/.config/hypr/scripts/volume-mute.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-mute.sh"
                },
                {
                    "label": "󰍭   Mic off",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh $HOME/.config/hypr/scripts/mic-mute.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-mic.sh"
                },
                {
                    "label": "󰤨   Wi-Fi",
                    "command": "swaync-client -cp; $HOME/.config/hypr/scripts/wifi-menu.sh"
                },
                {
                    "label": "󰂯   Bluetooth",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh $HOME/.config/hypr/scripts/toggle-bluetooth.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-bluetooth.sh"
                },
                {
                    "label": "󰂛   Do Not Disturb",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh swaync-client -d -sw",
                    "update-command": "swaync-client -D"
                },
                {
                    "label": "󰖔   Night light",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh $HOME/.config/hypr/scripts/nightlight.sh toggle",
                    "update-command": "$HOME/.config/hypr/scripts/nightlight.sh is-on"
                },
                {
                    "label": "󰅶   Caffeine",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/cc-action.sh $HOME/.config/hypr/scripts/caffeine-toggle.sh",
                    "update-command": "[ -f $HOME/.cache/caffeine_active ] && echo true || echo false"
                },
                {
                    "label": "󰄀   Screenshot",
                    "command": "swaync-client -cp; sleep 0.4; $HOME/.config/hypr/scripts/screenshot.sh region"
                }
            ]
        }
    }
}
