{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "left",
    "positionY": "top",
    "control-center-positionX": "left",
    "control-center-positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "cssPriority": "user",
    "ignore-gtk-theme": true,
    "control-center-width": 380,
    "control-center-height": 780,
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 12,
    "control-center-margin-right": 0,
    "control-center-margin-left": 12,
    "notification-2fa-action": true,
    "notification-inline-replies": true,
    "notification-window-width": 380,
    "notification-icon-size": 60,
    "notification-body-image-height": 180,
    "notification-body-image-width": 180,
    "timeout": 12,
    "timeout-low": 6,
    "timeout-critical": 1,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "widgets": [
        "mpris",
        "title",
        "notifications",
        "volume",
        "backlight",
        "buttons-grid"
    ],
    "widget-config": {
        "title": {
            "text": "Notification Center",
            "clear-all-button": true,
            "button-text": "󰆴"
        },
        "label": {
            "max-lines": 1,
            "text": "Notification Center!"
        },
        "mpris": {
            "image-size": 80,
            "image-radius": 12
        },
        "volume": {
            "label": "󰕾 ",
            "show-value": true
        },
        "backlight": {
            "label": "󰃟 ",
            "device": "intel_backlight",
            "subsystem": "backlight"
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰝟",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/volume-mute.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-mute.sh"
                },
                {
                    "label": "󰍭",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/mic-mute.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-mic.sh"
                },
                {
                    "label": "",
                    "command": "kitty -e nmtui"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "$HOME/.config/hypr/scripts/toggle-bluetooth.sh",
                    "update-command": "$HOME/.config/hypr/scripts/check-bluetooth.sh"
                },
                {
                    "label": "󰤄",
                    "type": "toggle",
                    "command": "swaync-client -d -sw",
                    "update-command": "swaync-client -D"
                },
                {
                    "label": "󰄪",
                    "command": "kitty -e btop"
                }
            ]
        }
    }
}
